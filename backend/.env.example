DATABASE_URL="postgresql://user_grafica:password_segura@localhost:5432/printflow_db"
PORT=3000

# --- AUTENTICAÇÃO ---
# Segredo usado para assinar os JWTs. Obrigatório — o servidor não sobe sem ele.
# Gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade do token (formato do jsonwebtoken: 7d, 12h, etc.)
JWT_EXPIRES_IN=7d

# Origens permitidas para CORS (Express e Socket.io), separadas por vírgula.
# Requisições sem header Origin (apps mobile, curl, webhooks da Meta) são sempre aceitas.
# Ex.: ALLOWED_ORIGINS=http://localhost:8080,https://app.suagrafica.com.br
ALLOWED_ORIGINS=

# WhatsApp Cloud API (Mock Environment)
WEBHOOK_VERIFY_TOKEN=dev_token_123
USE_MOCK_WHATSAPP=true

# --- WHATSAPP CLOUD API ---
# Token de acesso
WA_ACCESS_TOKEN=

# Identificação do número de telefone (Phone Number ID)
WA_PHONE_NUMBER_ID=

# Identificação da conta do WhatsApp Business (WABA ID)
WA_WABA_ID=

# --- META APP DETAILS ---
# ID do Aplicativo (App ID)
APP_ID=

# Chave secreta do aplicativo (App Secret)
APP_SECRET=

# --- LLM PROVIDER ---
# Provider de LLM de geração. Aceita "groq" (default) ou "gemini".
# Embeddings continuam via Gemini independente desta flag.
LLM_PROVIDER=groq

# Chave(s) de API do Google Gemini (sempre necessária — usada para embeddings).
# Suporta múltiplas chaves separadas por vírgula para round-robin
# (contorna rate limit do tier free): GOOGLE_API_KEY=key1,key2,key3
GOOGLE_API_KEY=

# Chave(s) de API do Groq (necessária quando LLM_PROVIDER=groq).
# Suporta múltiplas chaves separadas por vírgula para round-robin.
GROQ_API_KEY=

# Overrides opcionais de modelo. Se omitidos, a factory escolhe o default do provider.
#   groq:   rag/extractor → llama-3.1-8b-instant
#   gemini: rag/extractor → gemini-2.5-flash
# LLM_MODEL=
# LLM_EXTRACTOR_MODEL=

# --- GERENCIAMENTO DE CONVERSA ---
CONVERSATION_HISTORY_LIMIT=20

# Exige que o admin revise/aprove o orçamento calculado pela IA antes de
# enviá-lo ao cliente. Quando "true", o FSM pausa em AGUARDAR_APROVACAO_ADMIN
# após CALCULAR_ORCAMENTO. Os testes E2E definem explicitamente "false" no
# helpers.ts para preservar o fluxo de 1 turno.
ADMIN_APPROVAL_REQUIRED=true

GOOGLE_APPLICATION_CREDENTIALS="./keys/autograph-83959-firebase-adminsdk-fbsvc-fca4a61e3b.json"
