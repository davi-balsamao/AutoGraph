generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Role {
  CLIENTE
  GERENTE
  FUNCIONARIO
}

// Espelha ConversationState (src/fsm/states.ts). Mantê-los em sincronia.
enum EstadoConversa {
  BOAS_VINDAS
  IDENTIFICAR_NECESSIDADE
  COLETAR_ESPECIFICACOES
  VALIDAR_ARQUIVO
  CALCULAR_ORCAMENTO
  AGUARDAR_APROVACAO_ADMIN
  APRESENTAR_ORCAMENTO
  AGUARDAR_APROVACAO
  NEGOCIAR
  COLETAR_DADOS_ENTREGA
  CONFIRMAR_PEDIDO
  GERAR_OS
  ESCLARECER_DUVIDA
  PRODUTO_INDISPONIVEL
  ESCALAR_HUMANO
  AGUARDAR_RETORNO
  ENCERRAR
}

enum StatusOS {
  CRIADA
  AGUARDANDO_ORCAMENTO
  EM_PRODUCAO
  PRONTA_PARA_RETIRADA
  ENTREGUE
  CANCELADA
}

enum OrigemMensagem {
  CLIENTE
  BOT
  GERENTE
}

enum StatusPagamento {
  PENDENTE
  SINAL_PAGO
  PAGO
  ESTORNADO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  BOLETO
  TRANSFERENCIA
}

enum ModalidadeEntrega {
  RETIRADA
  ENTREGA
}

enum TipoArquivo {
  ARTE_FINAL
  ARTE_RASCUNHO
  MOCKUP
  COMPROVANTE_PAGAMENTO
  OUTRO
}

model Usuario {
  id               String     @id @default(uuid())
  nome             String
  email            String?    @unique
  telefone         String     @unique
  senha            String?
  role             Role       @default(CLIENTE)
  atendimentoHumano Boolean    @default(false) // <- CEREJA DO BOLO: Controla se a IA responde
  fcmToken         String?
  enderecoCompleto  String?
  enderecoReferencia String?
  criadoEm         DateTime   @default(now())
  atualizadoEm     DateTime   @updatedAt
  deletedAt        DateTime?  // soft-delete

  ordensDeServico     OrdensDeServico[]   @relation("Cliente")
  ordensResponsavel   OrdensDeServico[]   @relation("Responsavel") // OS onde é o funcionário responsável
  historicoAlteracoes HistoricoStatusOS[] @relation("AlteradoPor")
  mensagens           Mensagens[]
  sessoes             SessaoAtendimento[]
  enderecos           Endereco[]
}

model SessaoAtendimento {
  id              String   @id @default(uuid())
  clienteId       String
  cliente         Usuario  @relation(fields: [clienteId], references: [id])
  estadoAtual     EstadoConversa  @default(BOAS_VINDAS)
  estadoAnterior  EstadoConversa?
  contexto        Json     @default("{}")
  ativa           Boolean  @default(true)
  lembreteEnviado Boolean  @default(false)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([clienteId, ativa])
}

model OrdensDeServico {
  id                String   @id @default(uuid())
  numero            Int      @unique @default(autoincrement()) // número sequencial humano (OS #1024)
  clienteId         String
  responsavelId     String?  // funcionário responsável (kanban)
  status            StatusOS @default(CRIADA)
  especificacoes    Json
  observacoes       String?  // <-- CAMPO DE OBSERVAÇÕES
  mensagem_sugerida String?  // <- MENSAGEM SUGERIDA (Opcional)
  timerStartedAt    DateTime?
  timerEndedAt      DateTime?
  durationSeconds   Int      @default(0)

  // Pagamento (denormalizado p/ leitura rápida de kanban/relatório; detalhes em Pagamento[])
  valorTotal        Decimal?        @db.Decimal(10, 2)
  desconto          Decimal?        @db.Decimal(10, 2)
  statusPagamento   StatusPagamento @default(PENDENTE)

  // Entrega
  modalidadeEntrega    ModalidadeEntrega @default(RETIRADA)
  enderecoEntregaId    String?
  freteValor           Decimal?          @db.Decimal(10, 2)
  codigoRastreio       String?
  transportadora       String?
  dataEntregaPrevista  DateTime?
  dataEntregaRealizada DateTime?
  enderecoEntregaSnapshot Json? // cópia imutável do endereço de entrega no fechamento

  // Arte aprovada (ponteiro rápido; detalhes/versões em ArquivoOS[])
  arteAprovadaId    String?

  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
  deletedAt         DateTime? // soft-delete

  cliente           Usuario     @relation("Cliente", fields: [clienteId], references: [id])
  responsavel       Usuario?    @relation("Responsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  mensagens         Mensagens[]
  itens             ItemOS[]
  pagamentos        Pagamento[]
  arquivos          ArquivoOS[]         @relation("ArquivosDaOS")
  arteAprovada      ArquivoOS?          @relation("ArteAprovada", fields: [arteAprovadaId], references: [id], onDelete: SetNull)
  historicoStatus   HistoricoStatusOS[]
  enderecoEntrega   Endereco?           @relation(fields: [enderecoEntregaId], references: [id])

  @@index([status])
  @@index([clienteId])
  @@index([responsavelId])
  @@index([criadoEm])
  @@index([statusPagamento])
}

model Mensagens {
  id             String         @id @default(uuid())
  usuarioId      String
  ordemId        String?
  origem         OrigemMensagem
  payload        Json
  mediaUrl       String?        // sink p/ mídia recebida do WhatsApp (captura real: Fase 2)
  mediaMimeType  String?
  criadoEm       DateTime       @default(now())

  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  ordemDeServico OrdensDeServico? @relation(fields: [ordemId], references: [id])

  @@index([usuarioId])
  @@index([ordemId])
  @@index([criadoEm])
}

model DocumentosConhecimento {
  id        String                 @id @default(uuid())
  conteudo  String
  vetor     Unsupported("vector")?
  criadoEm  DateTime               @default(now())
}

model Produto {
  id           String   @id @default(uuid())
  nome         String   @unique
  descricao    String?
  imagemUrl    String?
  precoBase    Decimal  @db.Decimal(10, 2) @default(0) // ⚠️ acopla pricing.adapter + parsing frontend
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  deletedAt    DateTime? // soft-delete

  itens        ItemOS[]
}

// Item de uma OS: liga o pedido ao catálogo (Produto) e guarda um snapshot
// de nome/preço no momento da compra, para que relatórios históricos não mudem
// quando o catálogo for atualizado.
model ItemOS {
  id             String   @id @default(uuid())
  ordemId        String
  produtoId      String?  // null = produto custom fora do catálogo
  produtoNome    String   // snapshot do nome no momento do pedido
  quantidade     Int
  precoUnitario  Decimal  @db.Decimal(10, 2) // snapshot do preço no momento
  precoTotal     Decimal  @db.Decimal(10, 2)
  especificacoes Json     @default("{}") // material/acabamento/medidas deste item
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  ordem   OrdensDeServico @relation(fields: [ordemId], references: [id])
  produto Produto?        @relation(fields: [produtoId], references: [id])

  @@index([ordemId])
  @@index([produtoId])
}

// Pagamentos de uma OS (suporta sinal + parcelas). O valorTotal/statusPagamento
// denormalizados na OrdensDeServico são derivados a partir daqui no write-path.
model Pagamento {
  id             String          @id @default(uuid())
  ordemId        String
  valor          Decimal         @db.Decimal(10, 2)
  metodo         MetodoPagamento
  status         StatusPagamento @default(PENDENTE)
  ehSinal        Boolean         @default(false) // true = entrada/sinal
  comprovanteUrl String?
  pagoEm         DateTime?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  deletedAt      DateTime?       // soft-delete (registro financeiro)

  ordem OrdensDeServico @relation(fields: [ordemId], references: [id])

  @@index([ordemId])
  @@index([status])
}

// Arquivos oficiais da OS (arte final, rascunho, mockup, comprovante).
model ArquivoOS {
  id           String         @id @default(uuid())
  ordemId      String
  tipo         TipoArquivo    @default(ARTE_FINAL)
  url          String
  nomeOriginal String?
  mimeType     String?
  tamanhoBytes Int?
  aprovado     Boolean        @default(false)
  enviadoPor   OrigemMensagem @default(CLIENTE)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  ordem              OrdensDeServico   @relation("ArquivosDaOS", fields: [ordemId], references: [id])
  osComoArteAprovada OrdensDeServico[] @relation("ArteAprovada") // OS que apontam p/ este arquivo como arte aprovada

  @@index([ordemId])
}

// Endereço desacoplado do Usuario: permite múltiplos endereços/filiais por cliente
// e serve como destino de entrega referenciado pela OS.
model Endereco {
  id          String   @id @default(uuid())
  usuarioId   String?  // dono (cliente); null p/ snapshot avulso
  apelido     String?  // "Matriz", "Filial Centro"
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  referencia  String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario  Usuario?          @relation(fields: [usuarioId], references: [id])
  entregas OrdensDeServico[]

  @@index([usuarioId])
}

// Trilha de auditoria das transições de status da OS (SLA por etapa).
model HistoricoStatusOS {
  id          String    @id @default(uuid())
  ordemId     String
  de          StatusOS?
  para        StatusOS
  alteradoPor String?   // FK → Usuario (gerente/funcionário); null = sistema
  criadoEm    DateTime  @default(now())

  ordem             OrdensDeServico @relation(fields: [ordemId], references: [id])
  alteradoPorUsuario Usuario?       @relation("AlteradoPor", fields: [alteradoPor], references: [id], onDelete: SetNull)

  @@index([ordemId])
  @@index([alteradoPor])
}
