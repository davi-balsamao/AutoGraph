generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  CLIENTE
  GERENTE
}

enum StatusOS {
  CRIADA
  AGUARDANDO_ORCAMENTO
  EM_PRODUCAO
  PRONTA_PARA_RETIRADA
  ENTREGUE
  CANCELADA
}

enum OrigemMensagem {
  CLIENTE
  BOT
  GERENTE
}

model Usuario {
  id               String     @id @default(uuid())
  nome             String
  email            String?    @unique
  telefone         String     @unique
  senha            String?
  role             Role       @default(CLIENTE)
  atendimentoHumano Boolean    @default(false) // <- CEREJA DO BOLO: Controla se a IA responde
  fcmToken         String?
  criadoEm         DateTime   @default(now())
  atualizadoEm     DateTime   @updatedAt

  ordensDeServico OrdensDeServico[]
  mensagens        Mensagens[]
}

model OrdensDeServico {
  id                String   @id @default(uuid())
  clienteId         String
  status            StatusOS @default(CRIADA)
  especificacoes    Json
  observacoes       String?  // <-- CAMPO DE OBSERVAÇÕES
  mensagem_sugerida String?  // <- MENSAGEM SUGERIDA (Opcional)
  timerStartedAt    DateTime?
  timerEndedAt      DateTime?
  durationSeconds   Int      @default(0)
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  cliente           Usuario  @relation(fields: [clienteId], references: [id])
  mensagens         Mensagens[]
}

model Mensagens {
  id             String         @id @default(uuid())
  usuarioId      String
  ordemId        String?
  origem         OrigemMensagem
  payload        Json
  criadoEm       DateTime       @default(now())

  usuario        Usuario         @relation(fields: [usuarioId], references: [id])
  ordemDeServico OrdensDeServico? @relation(fields: [ordemId], references: [id])
}

model DocumentosConhecimento {
  id        String                 @id @default(uuid())
  conteudo  String
  vetor     Unsupported("vector")?
  criadoEm  DateTime               @default(now())
}

model Produto {
  id           String   @id @default(uuid())
  nome         String   @unique
  descricao    String?
  imagemUrl    String?
  precoBase    Float    @default(0.0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
